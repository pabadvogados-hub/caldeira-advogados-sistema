# Copie para config/.env e preencha. NUNCA versionar o .env.
# Sem uma credencial, a etapa correspondente e pulada (modo seguro): nada sai do escritorio.

# IA (obrigatoria) - conta Anthropic do escritorio
ANTHROPIC_API_KEY=
# Modelos (opcional): triagem juridica e extracao de dados
MODELO_TRIAGEM=claude-opus-5
MODELO_EXTRACAO=claude-sonnet-5

# Onde ficam as pastas dos clientes (servidor interno ou pasta sincronizada do Drive).
# CADA MAQUINA tem o seu .env, com o caminho como ELA enxerga a mesma pasta:
#   Windows: \\SERVIDOR\CLIENTES   ou   Z:\CLIENTES   ou   G:\Meu Drive\CLIENTES
#   Mac:     /Volumes/CLIENTES   (Finder > Ir > Conectar ao Servidor > smb://SERVIDOR/CLIENTES)
#            ou ~/Library/CloudStorage/GoogleDrive-EMAIL/Meu Drive/CLIENTES (Drive)
PASTA_CLIENTES_RAIZ=

# ZapSign - assinatura digital (Configuracoes > API no painel do ZapSign)
ZAPSIGN_API_TOKEN=

# Atende Direito - WhatsApp com o cliente
ATENDE_DIREITO_TOKEN=
NOME_ESCRITORIO=Caldeira Advogados Associados

# ADVBOX - cadastro de cliente/processo e tarefas
ADVBOX_API_TOKEN=
# nome (ou parte) do tipo de processo e da fase inicial no ADVBOX do escritorio
ADVBOX_TIPO_PROCESSO=
ADVBOX_FASE_INICIAL=

# Asaas - cobranca de honorarios
ASAAS_API_TOKEN=

# Conversao para PDF: usa o Word (Windows/Mac) e, sem ele, o LibreOffice. So preencher se o LibreOffice
# estiver fora do lugar padrao. Windows: C:\Program Files\LibreOffice\program\soffice.exe
#                               Mac:     /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=
# libreoffice = nao usar o Word (Mac sem Word, ou maquina das rotinas automaticas no Mac)
PDF_CONVERSOR=
# OCR de documento escaneado (opcional). So preencher se estiver fora do lugar padrao.
#   Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
#   Mac:     /opt/homebrew/bin/tesseract (M1/M2/M3)  ou  /usr/local/bin/tesseract (Intel)
TESSERACT_CMD=

# Numero (com DDD) que recebe alerta quando uma rotina ou integracao cai (precisa ser contato no Atende Direito)
ALERTA_WHATSAPP=

# Fase extrajudicial
# e-mail que aparece na notificacao para o banco responder (padrao: o das notificacoes do escritorio)
EMAIL_RESPOSTAS_BANCOS=
# dias corridos para o banco responder antes do alerta (padrao 10)
PRAZO_RESPOSTA_BANCO_DIAS=
# Gmail do escritorio (so cria RASCUNHO, nunca envia): cliente OAuth e token
GMAIL_CREDENCIAIS=config/credentials_gmail.json
GMAIL_TOKEN=config/token_gmail.json

# Controladoria (intimacoes do DJEN pelas OABs; o Dr. Augusto recebe no PJe pela OAB/MG 182.814)
OABS_MONITORADAS=11101/RO,14429/RO,182814/MG
PRAZO_INTERNO_DIAS_ANTES=3
# feriados estaduais/municipais no formato DD/MM/AAAA separados por virgula
FERIADOS_EXTRAS=
RELATORIO_CLIENTE_DIAS=30
# para onde vai a pasta do cliente quando o caso e encerrado
PASTA_ARQUIVO_CLIENTES=
ADVBOX_TIPO_TAREFA_PADRAO=
MODELO_CONTROLADORIA=
ADVBOX_INTERVALO_GET=2.1

# Comercial
# Meta Ads (so leitura: relatorio diario de campanhas)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# padrao v26.0 (o Meta desliga versoes antigas: a v24 saiu do ar em 06/10/2026)
META_API_VERSION=
# contas reserva (act_...,act_...) aceitas como destino do "MARKETING/main.py replicar"
META_AD_ACCOUNTS_RESERVA=
# ids de referencia do Meta (anotados no backup; ainda nao lidos pelo codigo)
META_APP_ID=
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_PAGE_ID=
META_INSTAGRAM_ID=
META_PIXEL_ID=
META_WHATSAPP_ACCOUNT_ID=
# API Flow do Atende Direito (opcional; e a que permite medir tempo de resposta na auditoria)
ATENDE_DIREITO_FLOW_TOKEN=
MODELO_SDR=
# Modelo das pecas juridicas (padrao claude-opus-5)
MODELO_PECAS=

# Marketing
# token SEPARADO com permissao ads_management, usado so em "acoes --aplicar" e "replicar --aplicar"
META_ACCESS_TOKEN_ACOES=
MODELO_MARKETING=
# enderecos publicados da landing e da calculadora (para os links e UTMs)
MARKETING_LANDING_URL=
MARKETING_CALCULADORA_URL=
